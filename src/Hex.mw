use Std.St as St
use Hex.Tables (quotedBytes)

@pub data FromHexError
  = InvalidHexCharacter Char Int -- A byte that is not a hex digit, taken as a character, and where it is.
  -- An odd number of digits.
  | OddLength
  -- The output is not the size the input needs.
  | InvalidStringLength

-- How Rust's `{:?}` writes byte `b` taken as a character.
fun quoted b =
  let rec seek k at = if k == b then at else seek (k + 1) (at + 3 + fieldAt at) in
  let at = seek 0 0 in
  stringSlice quotedBytes (at + 3) (at + 3 + fieldAt at)

fun fieldAt i =
  let d = \k -> toInt (stringByteAt quotedBytes (i + k)) - 48 in
  (d 0 * 64 + d 1) * 64 + d 2

@pub fun errorMessage e =
  match e with
  | FromHexError.InvalidHexCharacter c index ->
      "Invalid character ${quoted (charCode c)} at position ${index}"
  | FromHexError.OddLength -> "Odd number of digits"
  | FromHexError.InvalidStringLength -> "Invalid string length"

fun digitsOf table (input : #[UInt8]) =
  let n = arrayLen input in
  runSt (\() ->
    let buf = St.newArray (2 * n) (toUInt8 0) in
    let _ =
      St.forRange 0 n (\i ->
        let b = toInt (arrayGet input i) in
        let _ = St.set buf (2 * i) (stringByteAt table (b / 16)) in
        St.set buf (2 * i + 1) (stringByteAt table (b % 16)))
    in St.freeze buf)

-- `input` as lower-case hex.
@pub fun encode (input : #[UInt8]) = bytesToString (digitsOf "0123456789abcdef" input)

-- `input` as upper-case hex.
@pub fun encodeUpper (input : #[UInt8]) = bytesToString (digitsOf "0123456789ABCDEF" input)

-- The UTF-8 of `s`, as lower-case hex.
@pub fun encodeString s = encode (stringToBytes s)

-- `input` as lower-case hex, written into an output `size` bytes long, which
-- must be exactly twice `input`'s length.
@pub fun encodeToSlice (input : #[UInt8]) size =
  if arrayLen input * 2 != size then Err FromHexError.InvalidStringLength else Ok (encode input)

fun val (b : UInt8) index =
  let c = toInt b in
  if c >= 65 and c <= 70 then Ok (c - 55)
  else if c >= 97 and c <= 102 then Ok (c - 87)
  else if c >= 48 and c <= 57 then Ok (c - 48)
  else Err (FromHexError.InvalidHexCharacter (charFromCode c) index)

-- The pairs of digits from pair `k` on, into `buf`.
fun decodePairs (input : #[UInt8]) count =
  let rec check k =
    if k >= count then Ok ()
    else
      match val (arrayGet input (2 * k)) (2 * k) with
      | Err e -> Err e
      | Ok _ ->
          match val (arrayGet input (2 * k + 1)) (2 * k + 1) with
          | Err e -> Err e
          | Ok _ -> check (k + 1)
  in match check 0 with
     | Err e -> Err e
     | Ok _ ->
         let digit = \i -> match val (arrayGet input i) i with | Ok v -> v | Err _ -> 0 in
         Ok
           (runSt (\() ->
              let buf = St.newArray count (toUInt8 0) in
              let _ =
                St.forRange 0 count (\k ->
                  St.set buf k (toUInt8 (digit (2 * k) * 16 + digit (2 * k + 1))))
              in St.freeze buf))

-- `input`'s hex digits as bytes.
@pub fun decodeBytes (input : #[UInt8]) =
  if arrayLen input % 2 != 0 then Err FromHexError.OddLength
  else decodePairs input (arrayLen input / 2)

-- The hex digits of `text` as bytes.
@pub fun decode text = decodeBytes (stringToBytes text)

-- `input`'s hex digits as exactly `size` bytes.
@pub fun decodeToSlice (input : #[UInt8]) size =
  if arrayLen input % 2 != 0 then Err FromHexError.OddLength
  else if arrayLen input / 2 != size then Err FromHexError.InvalidStringLength
  else decodePairs input size
